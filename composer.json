{
  "name": "weather-tracking",
  "description": "A WordPress plugin for tracking weather.",
  "type": "wordpress-plugin",
  "version": "1.0.0",
  "authors": [
    {
      "name": "Sarfaraz Kazi"
    }
  ],

  "require": {},

  "require-dev": {
    "codeception/codeception": "^5.0",
    "codeception/module-asserts": "^3.0",
    "codeception/module-cli": "^2.0",
    "codeception/module-db": "^3.0",
    "codeception/module-filesystem": "^3.0",
    "codeception/module-phpbrowser": "^3.0",
    "codeception/module-rest": "^3.0",
    "codeception/module-webdriver": "^3.0",
    "lucatume/wp-browser": "^4.0",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^1.1"
  },

  "minimum-stability": "stable",

  "autoload": {
    "psr-4": {
      "Weather\\": "src/Weather/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "Weather\\Tests\\": "tests/_support/Helper/",
      "Weather\\Tests\\Traits\\": "tests/_support/Traits/"
    }
  },

  "scripts": {
    "test:analysis": [
      "phpstan analyse -c phpstan.neon.dist --memory-limit=512M"
    ]
  },

  "scripts-descriptions": {
    "test:analysis": "Run static code analysis."
  },

  "config": {
    "platform": {
      "php": "8.1.0"
    }
  }
}